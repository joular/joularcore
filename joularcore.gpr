library project Joularcore is

    --  Windows sets OS=Windows_NT; Linux/macOS/BSD leave it unset
    type Host_OS_Kind is ("Windows_NT", "other");
    Host_OS : Host_OS_Kind := external ("OS", "other");

    Default_OS := "linux";
    case Host_OS is
        when "Windows_NT"
            => Default_OS := "windows";
        when "other"
            => Default_OS := "linux";
    end case;

    -- Symbols to indicate which OS to compile for
    -- Build with: gprbuild -XPJ_OS=windows
    type OS_Platform is ("linux", "windows", "macos", "bsd");
    PJ_OS : OS_Platform := external ("PJ_OS", Default_OS);

    Defines := ();

    case PJ_OS is
        when "linux" =>
            Defines := ("-gnateDPJ_LINUX=True", "-gnateDPJ_WINDOWS=False",
                        "-gnateDPJ_MACOS=False", "-gnateDPJ_BSD=False");
        when "windows" =>
            Defines := ("-gnateDPJ_LINUX=False", "-gnateDPJ_WINDOWS=True",
                        "-gnateDPJ_MACOS=False", "-gnateDPJ_BSD=False");
        when "macos" =>
            Defines := ("-gnateDPJ_LINUX=False", "-gnateDPJ_WINDOWS=False",
                        "-gnateDPJ_MACOS=True", "-gnateDPJ_BSD=False");
        when "bsd" =>
            Defines := ("-gnateDPJ_LINUX=False", "-gnateDPJ_WINDOWS=False",
                        "-gnateDPJ_MACOS=False", "-gnateDPJ_BSD=True");
    end case;

    -- Library type
    -- static : libJoular_Core.a, linked into the client
    -- relocatable : libJoular_Core.so / .dll / .dylib
    -- static-pic : archive built position independent, so it can itself be linked into someone else's shared library
    type Library_Type_Kind is ("static", "relocatable", "static-pic");
    Library_Type : Library_Type_Kind :=
        external ("JOULARCORE_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));

    for Languages use ("Ada");
    for Library_Name use "Joular_Core";
    for Source_Dirs use ("src");
    for Object_Dir  use "obj/" & Library_Type;
    for Library_Dir use "lib/" & Library_Type;
    for Library_Kind use Library_Type;
    for Create_Missing_Dirs use "True";

    -- The relocatable (shared) library is stand-alone and encapsulated: it carries the Ada runtime and starts itself up when loaded, so programs in other languages (C, Python, Java, Rust, etc.) can simply load it and call the functions of include/joularcore.h, with nothing else needed
    case Library_Type is
        when "relocatable" =>
            for Library_Interface use ("Joular_Core", "Joular_Core.C_API");

            case PJ_OS is
                when "macos" =>
                    -- gprbuild cannot encapsulate on macOS, so the library loads the Ada runtime from its own file there
                    for Library_Standalone use "standard";
                when others =>
                    for Library_Standalone use "encapsulated";
            end case;

            case PJ_OS is
                when "linux" | "bsd" =>
                    for Library_Version use "libJoular_Core.so.0";
                when others =>
                    null;
            end case;

        when others =>
            null;
    end case;

    package Compiler is
        for Switches ("Ada") use ("-O3", "-gnat2012", "-gnatwa") & Defines;
    end Compiler;

    package Binder is
        for Switches ("Ada") use ("-static");
    end Binder;
end Joularcore;
