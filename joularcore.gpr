library project Joularcore is

    -- The OS to compile for, picked from the target gprbuild reports
    -- Override with: gprbuild -XPJ_OS=windows
    Host_Target := project'Target;
    Host_OS := external ("OS", "");
    Default_OS := "linux";

    -- The names are the canonical ones of gprconfig (OpenBSD has none, so build there with -XPJ_OS=bsd)
    case Host_Target is
        when "x86_64-windows" | "x86-windows"
            => Default_OS := "windows";
        when "aarch64-darwin" | "x86_64-darwin" | "x86-darwin"
            => Default_OS := "macos";
        when "x86_64-linux" | "aarch64-linux" | "arm-linux" | "armhf-linux" | "x86-linux"
            => Default_OS := "linux";
        when "x86_64-freebsd" | "aarch64-freebsd" | "x86-freebsd"
           | "x86_64-netbsd" | "aarch64-netbsd" | "x86_64-dragonfly"
            => Default_OS := "bsd";
        when others =>
            -- A name not listed above: Windows says so in its environment, anything else is taken as Linux
            case Host_OS is
                when "Windows_NT" => Default_OS := "windows";
                when others => null;
            end case;
    end case;

    type OS_Platform is ("linux", "windows", "macos", "bsd");
    PJ_OS : OS_Platform := external ("PJ_OS", Default_OS);

    -- Code shared by every OS is in src, the code of one OS in its own folder
    -- src/posix holds shared code for Linux, macOS and BSD
    -- The symbols in Defines let the example program print what applies to the OS it was built for
    Defines := ();

    case PJ_OS is
        when "linux" =>
            for Source_Dirs use ("src", "src/posix", "src/linux");
            Defines := ("-gnateDPJ_LINUX=True", "-gnateDPJ_WINDOWS=False",
                        "-gnateDPJ_MACOS=False", "-gnateDPJ_BSD=False");
        when "windows" =>
            for Source_Dirs use ("src", "src/windows");
            Defines := ("-gnateDPJ_LINUX=False", "-gnateDPJ_WINDOWS=True",
                        "-gnateDPJ_MACOS=False", "-gnateDPJ_BSD=False");
        when "macos" =>
            for Source_Dirs use ("src", "src/posix", "src/macos");
            Defines := ("-gnateDPJ_LINUX=False", "-gnateDPJ_WINDOWS=False",
                        "-gnateDPJ_MACOS=True", "-gnateDPJ_BSD=False");
        when "bsd" =>
            for Source_Dirs use ("src", "src/posix", "src/bsd");
            Defines := ("-gnateDPJ_LINUX=False", "-gnateDPJ_WINDOWS=False",
                        "-gnateDPJ_MACOS=False", "-gnateDPJ_BSD=True");
    end case;

    -- Whether the processor is a 64 bits x86, which has the CPUID instruction (only used on Windows, to read the RAPL registers)
    -- Override with: gprbuild -XPJ_X86=False
    Default_X86 := "False";
    case Host_Target is
        when "x86_64-windows" | "x86_64-darwin" | "x86_64-linux"
           | "x86_64-freebsd" | "x86_64-netbsd" | "x86_64-dragonfly"
            => Default_X86 := "True";
        when others
            => Default_X86 := "False";
    end case;

    type X86_Kind is ("True", "False");
    PJ_X86 : X86_Kind := external ("PJ_X86", Default_X86);

    Defines := Defines & ("-gnateDPJ_X86=" & PJ_X86);

    -- static : libjoularcore.a, linked into the client
    -- relocatable : libjoularcore.so / .dll / .dylib, with the C interface
    -- static-pic : archive built position independent, for someone else's shared library
    type Library_Type_Kind is ("static", "relocatable", "static-pic");
    Library_Type : Library_Type_Kind :=
        external ("JOULARCORE_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));

    for Languages use ("Ada");
    for Library_Name use "joularcore";
    for Object_Dir  use "obj/" & Library_Type;
    for Library_Dir use "lib/" & Library_Type;
    for Library_Kind use Library_Type;
    for Create_Missing_Dirs use "True";

    -- The shared library is stand-alone (it starts itself up when loaded) and, where gprbuild can, encapsulated (it carries the Ada runtime)
    -- So programs in C, Python, Java, Rust, etc. just load it and call include/joularcore.h
    case Library_Type is
        when "relocatable" =>
            for Library_Interface use ("Joular_Core", "Joular_Core.C_API");

            case PJ_OS is
                when "macos" =>
                    -- gprbuild cannot encapsulate on macOS, so the library loads the Ada runtime from its own file
                    for Library_Standalone use "standard";

                    -- gprbuild 26 writes the runtime folder into the library with a space in front, which macOS never finds
                    -- The specs file records that folder instead, so the library finds the runtime without DYLD_LIBRARY_PATH
                    for Run_Path_Option use ();
                    for Library_Options use ("-specs=" & project'Project_Dir & "src/macos/ada_runtime_rpath.specs");
                when others =>
                    for Library_Standalone use "encapsulated";
            end case;

            -- The number is the ABI: bump it only when the C interface changes in an incompatible way
            case PJ_OS is
                when "linux" | "bsd" =>
                    for Library_Version use "libjoularcore.so.0";
                when others =>
                    null;
            end case;

        when others =>
            null;
    end case;

    package Compiler is
        for Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa") & Defines;
    end Compiler;

    package Binder is
        for Switches ("Ada") use ("-static");
    end Binder;
end Joularcore;
